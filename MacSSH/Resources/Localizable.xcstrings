      "extractionState": "manual_uploaded",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask anything — the Agent can read the terminal context and files under the current directory (read-only). It cannot run commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时提问——Agent 可读取终端上下文与当前目录中的文件（只读），但不会执行任何命令。"
          }
        }
      }
    },
